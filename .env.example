# ============================================================
# kennote 環境變數範本
#   cp .env.example .env  然後至少填好 JWT_SECRET
#   所有變數都會經過 apps/server/src/env.ts 的 schema 驗證，
#   缺必填項目時 server 會啟動失敗並印出變數名稱與說明（04 §7.4 鐵律 1）
# ============================================================

# ============ 基本 ============
NODE_ENV=development
LOG_LEVEL=debug

# ============ Server ============
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
# 前端對外網址（OIDC callback、分享連結會用到）
PUBLIC_BASE_URL=http://localhost:5173
# 允許的跨來源前端。開發時 vite 會把 /api 代理到 server，同源，所以可留空
CORS_ORIGINS=http://localhost:5173

# ============ Database ============
# ★必填★
DATABASE_URL=postgres://kennote:kennote@localhost:5432/kennote
# 整合測試用的資料庫。留空時「需要真 DB 的測試」會自動 skip 而不是失敗
DATABASE_URL_TEST=
# pg Pool 上限，建議 (CPU 核心數 × 2) + 2
DATABASE_POOL_MAX=10

# ============ Redis（M5 之後才需要，留空＝用記憶體 broadcast）============
REDIS_URL=

# ============ 認證 ============
# ★必填★ 至少 32 字元：openssl rand -base64 48
JWT_SECRET=
# access token 存前端記憶體，15 分鐘
JWT_ACCESS_TTL_SECONDS=900
# refresh token 存 HttpOnly cookie，30 天（滑動）
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=
# 正式環境（HTTPS）必須設為 true
COOKIE_SECURE=false

# ============ OIDC 擴充點（留空＝該 provider 不啟用）============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ============ 檔案儲存 ============
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
# 50MB
STORAGE_MAX_FILE_SIZE=52428800
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 需要 true
S3_FORCE_PATH_STYLE=true

# ============ 速率限制 ============
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ============ 功能開關 ============
FEATURE_REALTIME=true
FEATURE_PUBLIC_SHARE=false
# M6 自建 OT 上線時才打開
FEATURE_OT=false

# ============ 前端（VITE_ 前綴才會進 client bundle；任何祕密都不能放這裡）============
# 空字串 = 同源 /api。開發時由 vite proxy、正式時由 nginx 反向代理到 server
VITE_API_BASE_URL=
VITE_WS_URL=

# ============ 正式部署（docker-compose.prod.yml 使用）============
POSTGRES_USER=kennote
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kennote
# 對外埠：http://<主機>:8090
WEB_PORT=8090

# 開放登入：登入頁不輸入或隨便輸入都能進（自動建立帳號／訪客）。公開對外時請設 false
FEATURE_OPEN_LOGIN=true
