{
  "name": "kennote",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "docker compose up",
    "dev:local": "pnpm -r --parallel dev",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @kennote/server migrate",
    "db:seed": "pnpm --filter @kennote/server seed",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:prop": "pnpm -r test -- --testNamePattern=prop",
    "deps:check": "tsx scripts/check-deps.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm deps:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
