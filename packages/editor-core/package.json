{
  "name": "@kennote/editor-core",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency, framework-agnostic vanilla TypeScript block editor engine for kennote.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "dependencies": {},
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc -p tsconfig.build.json --watch",
    "playground": "node scripts/playground.mjs"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
